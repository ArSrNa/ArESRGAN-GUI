{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArSrNaUIESRGAN",
  "version": "../package.json",
  "identifier": "cn.arsrna.esrgan",
  "build": {
    "beforeDevCommand": "pnpm run assets && pnpm run dev",
    "devUrl": "http://localhost:7777",
    "beforeBuildCommand": "pnpm run assets && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "超分辨率 | Ar-Sr-Na",
        "width": 1200,
        "height": 728,
        "minWidth": 1200,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:7777 http://localhost:7777",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/realesrgan-ncnn-vulkan"],
    "resources": {
      "resources/models/*": "models/",
      "resources/*.dll": "./"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
